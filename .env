VITE_API_URL=https://beneficios-backend-jfpx.onrender.com/api

# Client ID de Google OAuth. Es un valor PUBLICO (va embebido en el bundle de
# cualquier app con Google Sign-In), no es un secreto. Sirve para pintar el boton
# al instante sin esperar al backend; la fuente de verdad sigue siendo
# GET /api/public/auth-config, que lo pisa si difiere.
# Vive aca y no en el dashboard de Vercel a proposito: el proyecto beneficios-qr
# no tiene env vars y este .env viaja en el deploy (no esta en .vercelignore).
VITE_GOOGLE_CLIENT_ID=509756072406-pe4sjirk97m298vli60epi12ihk01cj1.apps.googleusercontent.com
